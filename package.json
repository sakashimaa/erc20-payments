{
  "name": "erc20-payments",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev:api": "bun --hot src/api/index.ts",
    "db:migrate": "bun src/db/migrate.ts",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio",
    "test:unit": "bun test src",
    "test:integration": "bun test tests --env-file=.env.test --preload ./tests/setup.ts",
    "test:infra": "docker compose up -d --wait",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "cli:xpub": "bun src/cli/export-xpub.ts",
    "cli:build": "bun build src/cli/export-xpub.ts --compile --outfile dist/export-xpub"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.4.4",
    "@typescript/native": "npm:typescript@^7.0.2",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.9.10",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.72.1"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.9.1",
    "@noble/curves": "^2.4.0",
    "@scure/base": "^2.4.0",
    "@scure/bip39": "^2.4.0",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.14",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "postgres": "^3.4.9",
    "viem": "^2.57.13",
    "zod": "^4.6.7",
    "zod-validation-error": "^5.0.0"
  }
}
